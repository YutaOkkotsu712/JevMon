SHOWDOWN_URL=wss://sim3.psim.us/showdown/websocket
DEBUG=false
SHOWDOWN_USERNAME=
SHOWDOWN_PASSWORD=
# Room ID or battle URL from Watch a battle; leave empty for challenge acceptance.
SHOWDOWN_BATTLE_ROOM=
# observe (default), random or jev. Decision modes require credentials.
BATTLE_MODE=observe
# No battle choices or challenge acceptance when true.
DRY_RUN=true
# Accept one challenge from this opponent, in gen9randombattle only.
# One account name, or * to accept whoever challenges first. Either way, one battle per run.
ACCEPT_CHALLENGES_FROM=
# Optional official TypeSafe Jev API credentials.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MAX_CALLS_PER_BATTLE=60
JEV_TIMEOUT_MS=6000
# False means no paid calls during dry-run; explicitly opt in for API testing.
JEV_CALLS_IN_DRY_RUN=false
# Set both from your actual account pricing to estimate cost; blank means unknown.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
# Live view port for the browser extension and http://127.0.0.1:8733; 0 turns it off.
LIVE_VIEW_PORT=8733
# Battles to play before the bot stops taking challenges; 0 keeps it up indefinitely.
# Counted in logs/battles-played across restarts; delete that file to reset.
MAX_BATTLES=0
# Where battles come from: challenges (only ACCEPT_CHALLENGES_FROM), ladder (search the
# ladder; challenges only once the run is over) or both (ladder, and take a challenge
# between ladder games, never during one). Blank: ladder if LADDER_BATTLES is set, else
# challenges.
PLAY_MODE=
# Ladder battles to finish in a run, one at a time. In ladder or both, 0 means no run
# length and MAX_BATTLES must end it. Counted in logs/ladder-battles-played; delete it
# for a new run.
LADDER_BATTLES=0
# Interface for the live view. Loopback by default; the container sets 0.0.0.0 so a
# published port can reach it. Never expose that port to the internet directly.
LIVE_VIEW_HOST=127.0.0.1
# Request-body budget in bytes. Not an API limit: the service has never refused a body for size, so this
# only keeps a decision small enough to read carefully. An oversized payload is still sent, and marked.
JEV_PAYLOAD_BUDGET_BYTES=28000
# Lookahead by poke-engine (build it first: npm run build:engine, needs Rust). off, advise (its verdict goes into
# Jev's payload) or blend (also averaged with Jev's probabilities to choose). Worlds are guesses at the hidden sets.
SEARCH_MODE=off
SEARCH_WORLDS=16
SEARCH_MS_PER_WORLD=100
# In blend, the search's share of the choice against Jev's probabilities, 0 to 1.
SEARCH_WEIGHT=0.5
# Whether Jev's payload carries the search's shares. Unset: yes, in every mode. false keeps Jev's opinion independent in
# blend; on the ladder that won 48% of 50 games against 63% of 234 with the shares shown.
SEARCH_IN_PAYLOAD=
# POKE_ENGINE_BIN=vendor/poke-engine/target/release/poke-engine
